{
    // Debug sonoff2hue in a local Home Assistant without hardware, with template lights for the switches to toggle.
    // Home Assistant's state goes to .dev/, which git ignores. See "Development" in README.md.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Home Assistant",
            "type": "debugpy",
            "request": "launch",
            // .dev/venv with Home Assistant, and its configuration folder .dev/config (scripts/develop setup).
            "preLaunchTask": "Set up the development Home Assistant",
            "python": "${workspaceFolder}/.dev/venv/bin/python",
            // "python -m" from the repository root puts the root first on the module search path, so Home Assistant
            // loads custom_components.sonoff2hue from this checkout, and breakpoints in its files are hit.
            "module": "homeassistant",
            // As scripts/develop runs it: assist_pipeline's requirements have no wheels for Python 3.14.
            "args": ["--config", "${workspaceFolder}/.dev/config", "--skip-pip-packages", "pymicro-vad,pyspeex-noise"],
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "console": "integratedTerminal",
            // Stop sends Ctrl+C, so that Home Assistant shuts down and saves its state; a second Stop kills it.
            "onTerminate": "KeyboardInterrupt",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Now listening on port ([0-9]+)",
                "uriFormat": "http://127.0.0.1:%s/"
            }
        }
    ]
}
