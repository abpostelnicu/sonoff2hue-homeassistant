<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generates the test fixtures that pin the port's .NET semantics; see README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- As the sonoff2hue app runs. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- -p:Sonoff2HueProject=<checkout of abpostelnicu/sonoff2hue>/src/Sonoff2Hue/Sonoff2Hue.csproj runs the app's code. -->
  <PropertyGroup Condition="'$(Sonoff2HueProject)' != ''">
    <DefineConstants>$(DefineConstants);SONOFF2HUE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Sonoff2HueProject)' != ''">
    <ProjectReference Include="$(Sonoff2HueProject)" />
  </ItemGroup>
</Project>
